generator cliente {
    provider = "prisma-client-js"
    output = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
    
}

enum MovementType {
    ENTRY
    EXIT
    ADJUSTMENT
}

model Stock {
    id Int @id @default(autoincrement())
    productId Int @unique
    quantidade Int
    updatedAt DateTime @updatedAt
}

model StockMovement {
    id Int @id  @default(autoincrement())
    productId Int
    quantidade Int
    type MovementType
    createdAt DateTime @default(now())
}