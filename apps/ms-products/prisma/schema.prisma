generator client {
    provider = "prisma-client-js"
    output = "../src/generated/prisma"
    moduleFormat    = "cjs"
}

datasource db {
    provider = "postgresql"
}

model Product {
  id           Int      @id @default(autoincrement())

  nome         String
  descricao    String?
  preco        Decimal  @db.Decimal(10,2)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}